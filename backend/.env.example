# ==============================================================================
# ORCA MARINE AGENTIC AI PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` and fill in your actual credentials / API keys.
# ==============================================================================

# ── LLM & AI Vision Inference Providers ──────────────────────────────────────
# NVIDIA NIM API Key (used for seasonal ban PDF document vision extraction)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (used for fast fallback chat & routing inference)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (used for multi-model fallback reasoning)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OmniRoute Local Proxy Configuration (Primary Agent Router)
OMNIROUTE=your_omniroute_key_here
OMNIROUTE_API_KEY=your_omniroute_key_here
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=anti1

# ── Indian Space Agency (ISRO) Credentials ────────────────────────────────────
# ISRO Bhuvan Geoportal Token (Coastal Land Use / Land Cover LULC API)
BHUVAN_LULC_TOKEN=your_bhuvan_lulc_token_here

# ISRO MOSDAC Satellite Credentials (INSAT-3DS, Oceansat-3, EOS-06 data downloads)
MOSDAC_USERNAME=your_mosdac_username
MOSDAC_PASSWORD=your_mosdac_password

# ── NASA & Global Earth Observation Credentials ──────────────────────────────
# NASA Earthdata Login (MODIS Aqua Chlorophyll & CMR downloads)
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# ── Maritime & Vessel Surveillance ───────────────────────────────────────────
# Global Fishing Watch (GFW) API JWT Token (vessel density & fleet tracking)
GFW_TOKEN=your_gfw_jwt_token_here

# AISStream API Key (Optional live satellite/terrestrial AIS stream)
# AISSTREAM_API=your_aisstream_api_key_here
